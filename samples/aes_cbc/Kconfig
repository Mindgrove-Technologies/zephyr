mainmenu "AES CBC Test Suite"

source "Kconfig.zephyr"

config AES_CBC_TEST_SUITE
    bool "Enable AES CBC Test Suite Infrastructure"
    default y
    select CRYPTO
    help
      Master switch for the AES CBC testing suite.

